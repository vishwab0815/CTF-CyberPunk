# Copy to .env and fill in. The only REQUIRED variable is MONGODB_URI.

# MongoDB connection string (MongoDB Atlas or any MongoDB). REQUIRED.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/
MONGODB_URI=

# Database name inside the cluster. Defaults to nebula_range.
# MONGODB_DB=nebula_range

# Folder scanned for challenge packs (each subfolder holds a challenge.json and a files/ directory).
# CHALLENGES_DIR=./challenges

# Prefix of every flag, e.g. RANGE{...}. 2-16 chars of A-Z a-z 0-9 _
# FLAG_PREFIX=RANGE

# HMAC secret (>= 32 chars) behind per-player flags. Strongly recommended in production so the
# secret is stable and known. If unset, a random one is generated once and stored in the database.
# Changing it invalidates every issued dynamic flag. Never commit the real value.
# FLAG_SECRET=

# Bootstrap an administrator at startup. Created once; never overwrites an existing password.
# You can instead run: pnpm admin:create <handle> <password>
# ADMIN_HANDLE=organiser
# ADMIN_PASSWORD=choose-a-long-passphrase

# Set to 1 ONLY behind a reverse proxy you control that overwrites X-Forwarded-For (enables per-IP
# rate limits). On Vercel this is handled for you. Without it, per-IP limits use a global ceiling.
# TRUST_PROXY=0

# Mark the session cookie Secure. Defaults to on in production; set 0 for plain-HTTP LAN events.
# COOKIE_SECURE=1

# Exact public origin (scheme://host[:port]) for CSRF checks when behind a proxy that rewrites Host.
# APP_ORIGIN=https://ctf.example.org

# Session lifetime in days.
# SESSION_TTL_DAYS=30
